# Copy to .env.local and fill in. Never commit real values.
# Local default when unset: postgres://postgres:postgres@localhost:54329/resort (npm run db:start)
DATABASE_URL=
# Long random string; signs the session cookie (HS256).
SESSION_SECRET=
# Long random string; signs TestPay payment callbacks (HMAC-SHA256).
PAYMENT_WEBHOOK_SECRET=
APINEX_API_KEY=
OLLAMA_API_KEY=
